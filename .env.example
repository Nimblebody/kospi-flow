# KIS Developers 에서 발급받은 값 (실전투자 기준)
KIS_APP_KEY=여기에_앱키
KIS_APP_SECRET=여기에_앱시크릿
# prod = 실전투자, vps = 모의투자
KIS_ENV=prod

# 텔레그램 알림 (선택)
TELEGRAM_BOT_TOKEN=
# 여러 명에게 보내려면 쉼표로: 12345678,-1009876543210
TELEGRAM_CHAT_ID=

# 알림 메시지에 붙일 대시보드 주소 (GitHub Pages)
SITE_URL=https://<깃허브아이디>.github.io/<저장소이름>/

# 사내망 등에서 마스터 파일 다운로드가 막힐 때 1 로 두면 내장 테마 사전을 쓴다
SKIP_MASTER_DOWNLOAD=0

# Cloudflare Worker (정시 실행·스크리너 중계). worker/README.md 참고
WORKER_URL=https://kospi-flow-scheduler.<계정이름>.workers.dev
# Worker 대시보드의 TRIGGER_KEY 와 같은 값. 대시보드에서는 다시 볼 수 없으니 여기 적어 둔다
TRIGGER_KEY=

# 장중 스크리너 — eFriend Plus 로그인 ID. [0110] 조건검색을 불러올 때 쓴다
KIS_HTS_ID=
